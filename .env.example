# Base URL of your Jellyfin server, e.g. http://192.168.1.10:8096
JF_URL=

# Jellyfin API key (Dashboard > API Keys)
JF_API_KEY=

# Optional: library display names, only used as a fallback if the
# CollectionType lookup doesn't match (default values shown)
JF_MOVIES_LIBRARY_NAME=Movies
JF_TV_LIBRARY_NAME=TV Shows
